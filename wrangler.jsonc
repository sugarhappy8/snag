{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers: `npm run build` writes dist/, `wrangler deploy` uploads it.
  // The game talks to LM Studio straight from the player's browser, so there is no server code.
  "name": "anotherlife",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
