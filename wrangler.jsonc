{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snagdeals",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snagdeals",
      "database_id": "7fd251c7-134e-4533-a596-27a98400188a",
      "migrations_dir": "migrations"
    }
  ],
  // Price check + alert job. Runs hourly; each run refreshes the stalest games.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_URL": "https://snagdeals.store",
    "FROM_EMAIL": "SnagDeals <alerts@snagdeals.store>"
  }
  ,"routes": [{ "pattern": "snagdeals.store", "custom_domain": true }]
}
