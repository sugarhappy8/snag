{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snagdeals",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snagdeals",
      // Replace with the id printed by `npx wrangler d1 create snagdeals`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Price check + alert job. Runs hourly; each run refreshes the stalest games.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_URL": "https://snagdeals.store",
    "FROM_EMAIL": "SnagDeals <alerts@snagdeals.store>"
  }
  // After snagdeals.store is on Cloudflare DNS, uncomment to serve the site there:
  // ,"routes": [{ "pattern": "snagdeals.store", "custom_domain": true }]
}
